# ==============================================================================
# VAIVAS VENTURES & VAIVAS ADS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# PostgreSQL Database Connection (Prisma)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/vaivas_ventures?schema=public"

# Authentication & Security
JWT_SECRET="generate_a_secure_random_64_character_hex_or_base64_secret_key"
ADMIN_DEFAULT_EMAIL="admin@vaivasventures.com"
ADMIN_DEFAULT_PASSWORD="YourStrongAdminPasswordHere"

# Base Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_VAIVAS_ADS_URL="http://localhost:3000/ads"

# File Upload & Media Storage (Staff artwork, proofs, invoices)
# By default, files are stored locally in public/uploads and persistent directories.
# Optional Object Storage (AWS S3 / Supabase / Cloudflare R2):
STORAGE_PROVIDER="local" # "local" | "s3" | "supabase"
# S3_BUCKET_NAME=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Optional Transactional Notifications (Disabled until staff configures provider)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Vaivas Ads <ads@vaivasventures.com>"
